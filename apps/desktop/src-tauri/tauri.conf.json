{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cellar",
  "version": "0.1.0",
  "identifier": "com.cellar.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cellar",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        },
        "transparent": false,
        "backgroundColor": "#0c0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QjRGMjE3RTI1ODYwOEQKUldTTllGamlGL0swNWRCNnE5enNpTUZycE5wZU9CWDlpbm9EcEFxQzFYN3BBZ3pCQ0hvMWV5SHQK",
      "endpoints": [
        "https://github.com/MRL-00/cellar/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
