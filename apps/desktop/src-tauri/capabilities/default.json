{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Cellar's main window — only the Tauri commands declared in src/commands/ are callable from the frontend.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "updater:default",
    "process:default",
    "opener:allow-open-url"
  ]
}
